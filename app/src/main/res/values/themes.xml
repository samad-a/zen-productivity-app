<resources>
    <!--
    Light and dark both come from the colour tokens in colors.xml, which values-night
    redefines. The user can follow the system or pick one in Settings.
    -->
    <style name="Base.Theme.Zen" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary is dark green so focus outlines, cursors and switches meet 3:1 on white -->
        <item name="colorPrimary">@color/dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green</item>
        <item name="colorOnPrimaryContainer">@color/dark_green</item>
        <item name="colorSecondaryContainer">@color/light_green</item>
        <item name="colorOnSecondaryContainer">@color/dark_green</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dark_green</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Unchecked switch track; the default is lavender -->
        <item name="colorSurfaceContainerHighest">@color/switch_track_off</item>
        <!-- Bottom sheets and dialogs; the defaults are tinted lavender -->
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.Zen.Button</item>
        <item name="materialSwitchStyle">@style/Widget.Zen.Switch</item>
    </style>

    <style name="Theme.Zen" parent="Base.Theme.Zen" />

    <!--
    Launch theme: the system splash screen shows the logo, then MainActivity switches to
    Theme.Zen. Android 12+ animates the petals opening (values-v31); older versions show
    the open logo.
    -->
    <style name="Theme.Zen.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Zen</item>
    </style>
</resources>
