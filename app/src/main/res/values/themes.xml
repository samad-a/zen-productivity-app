<resources>
    <!--
    The app is designed as a light-only theme: layouts use fixed light backgrounds and
    dark green text, so a DayNight parent would give light text on white in dark mode.
    -->
    <style name="Base.Theme.Zen" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary is dark green so focus outlines, cursors and switches meet 3:1 on white -->
        <item name="colorPrimary">@color/dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green</item>
        <item name="colorOnPrimaryContainer">@color/dark_green</item>
        <item name="colorSecondaryContainer">@color/light_green</item>
        <item name="colorOnSecondaryContainer">@color/dark_green</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dark_green</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Unchecked switch track; the default is lavender -->
        <item name="colorSurfaceContainerHighest">#FFEFEFEF</item>
        <!-- Bottom sheets and dialogs; the defaults are tinted lavender -->
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.Zen.Button</item>
        <item name="materialSwitchStyle">@style/Widget.Zen.Switch</item>
    </style>

    <style name="Theme.Zen" parent="Base.Theme.Zen" />
</resources>
