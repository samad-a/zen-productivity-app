<resources>
    <!--
    The app is designed as a light-only theme: layouts use fixed light backgrounds and
    dark green text, so a DayNight parent would give light text on white in dark mode.
    -->
    <style name="Base.Theme.Zen" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/dark_green</item>
        <item name="colorAccent">@color/light_green</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.Zen" parent="Base.Theme.Zen" />
</resources>
