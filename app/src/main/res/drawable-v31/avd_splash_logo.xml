<?xml version="1.0" encoding="utf-8"?>
<!-- The petals open from a closed bud: the side petals fall outwards and the centre one grows -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo_closed">
    <target android:name="leftPetal">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:startOffset="100"
                android:valueFrom="45"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="rightPetal">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:startOffset="100"
                android:valueFrom="-45"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="centrePetal">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator
                    android:duration="650"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="100"
                    android:valueFrom="0.85"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="650"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="100"
                    android:valueFrom="0.85"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
