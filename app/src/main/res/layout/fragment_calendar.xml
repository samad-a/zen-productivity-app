<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".calendar.CalendarFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_large">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:id="@+id/calendarTitle"
                style="@style/Widget.Zen.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/title_margin_top"
                android:gravity="center_horizontal"
                android:text="@string/calendar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/previousMonthButton"
                    style="@style/Widget.Zen.NavIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/previous_month"
                    app:icon="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/monthText"
                    style="@style/Widget.Zen.SectionHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    tools:text="October 2026" />

                <Button
                    android:id="@+id/nextMonthButton"
                    style="@style/Widget.Zen.NavIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/next_month"
                    app:icon="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Weekday initials, filled in by CalendarFragment; each day cell reads its full date -->
            <LinearLayout
                android:id="@+id/weekdayRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daysGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <include
                android:id="@+id/legend"
                layout="@layout/view_heat_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:id="@+id/selectedDayText"
                        style="@style/Widget.Zen.SectionHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Thursday 8 October" />

                    <TextView
                        android:id="@+id/daySessionsText"
                        style="@style/Widget.Zen.StatLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="3 study sessions" />

                    <TextView
                        android:id="@+id/dayFocusText"
                        style="@style/Widget.Zen.StatLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="1 h 15 min focused" />

                    <TextView
                        android:id="@+id/dayTasksText"
                        style="@style/Widget.Zen.StatLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="2 tasks finished" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
