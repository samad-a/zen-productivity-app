<?xml version="1.0" encoding="utf-8"?>
<!-- A tappable settings row: a title with an optional summary underneath. The
     background is only the touch ripple, so lint's overdraw warning doesn't apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingVertical="@dimen/spacing_small"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_green"
        android:textSize="@dimen/text_body_large"
        tools:text="Theme" />

    <TextView
        android:id="@+id/rowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone"
        tools:text="Follow system"
        tools:visibility="visible" />
</LinearLayout>
