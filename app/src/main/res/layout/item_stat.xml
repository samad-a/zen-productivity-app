<?xml version="1.0" encoding="utf-8"?>
<!-- One big number with its label, read together by screen readers -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Zen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/statContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/statValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/dark_green"
            android:textSize="@dimen/text_stat"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="@dimen/text_stat"
            app:autoSizeMinTextSize="20sp"
            app:autoSizeTextType="uniform"
            tools:text="42" />

        <TextView
            android:id="@+id/statLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_green"
            android:textSize="@dimen/text_body"
            tools:text="tasks completed" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
