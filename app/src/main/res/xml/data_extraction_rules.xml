<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12 and higher. With no rules, everything in the app's data
    directory is backed up to the user's Google account and copied on device-to-device transfer:
    the Room database (tasks) and SharedPreferences (timer settings).
    See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
